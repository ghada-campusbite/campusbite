{
  "expo": {
    "name": "CampusBite",
    "slug": "campusbite",
    "scheme": "campusbite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#4c1d95"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.campusbite.student",
      "supportsTablet": false
    },
    "android": {
      "package": "com.campusbite.student",
      "supportsRtl": true
    }
  }
}