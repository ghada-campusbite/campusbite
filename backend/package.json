{
  "name": "campusbite-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/main.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "sh scripts/migrate.sh",
    "db:seed": "prisma db seed",
    "test": "jest",
    "test:e2e": "node test/run-e2e.mjs",
    "db:bootstrap": "node scripts/bootstrap-db.cjs",
    "test:split-role": "npm run build && node test/split-role.mjs",
    "test:proxy-hops": "npm run build && node test/proxy-hops.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "prisma": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "embedded-postgres": "^19.0.0-beta.20",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
